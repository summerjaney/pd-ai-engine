  "screens": [
    {
      "id": "request-list",
      "name": "申请列表",
      "route": "/requests",
      "pattern": "list",
      "frame": {
        "width": 1440,
        "height": 1024
      },
      "nodes": [
        {
          "id": "request-list.section.header",
          "name": "页面头部",
          "type": "section",
          "component": "page-header",
          "description": "申请列表标题、路由与角色标记"
        },
        {
          "id": "request-list.field.requestNo",
          "name": "申请编号",
          "type": "field",
          "component": "text-input",
          "description": "申请列表中的申请编号",
          "required": false
        },
        {
          "id": "request-list.field.applicant",
          "name": "申请人",
          "type": "field",
          "component": "text-input",
          "description": "申请列表中的申请人",
          "required": false
        },
        {
          "id": "request-list.field.department",
          "name": "所属部门",
          "type": "field",
          "component": "text-input",
          "description": "申请列表中的所属部门",
          "required": false
        },
        {
          "id": "request-list.field.type",
          "name": "请假类型",
          "type": "field",
          "component": "select",
          "description": "申请列表中的请假类型",
          "required": false
        },
        {
          "id": "request-list.field.startAt",
          "name": "开始时间",
          "type": "field",
          "component": "date-time-picker",
          "description": "申请列表中的开始时间",
          "required": false
        },
        {
          "id": "request-list.field.endAt",
          "name": "结束时间",
          "type": "field",
          "component": "date-time-picker",
          "description": "申请列表中的结束时间",
          "required": false
        },
        {
          "id": "request-list.field.duration",
          "name": "请假时长",
          "type": "field",
          "component": "text-input",
          "description": "申请列表中的请假时长",
          "required": false
        },
        {
          "id": "request-list.field.status",
          "name": "审批状态",
          "type": "field",
          "component": "select",
          "description": "申请列表中的审批状态",
          "required": false
        },
        {
          "id": "request-list.action.create",
          "name": "新建申请",
          "type": "action",
          "component": "primary-button",
          "description": "申请列表中的新建申请操作"
        },
        {
          "id": "request-list.action.view",
          "name": "查看",
          "type": "action",
          "component": "secondary-button",
          "description": "申请列表中的查看操作"
        },
        {
          "id": "request-list.action.withdraw",
          "name": "撤回",
          "type": "action",
          "component": "danger-button",
          "description": "申请列表中的撤回操作"
        }
      ],
      "interactions": [
        {
          "sourcePageId": "request-list",
          "triggerType": "action",
          "triggerId": "create",
          "triggerLabel": "新建申请",
          "targetPageId": "request-create"
        },
        {
          "sourcePageId": "request-list",
          "triggerType": "action",
          "triggerId": "view",
          "triggerLabel": "查看",
          "targetPageId": "request-detail"
        }
      ]
    },
