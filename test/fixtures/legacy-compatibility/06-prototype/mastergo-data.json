    "description": "依据原始需求生成的 B 端产品原型模型。"
  },
  "tokens": {
    "color": {
      "primary": "#3B82F6",
      "success": "#10B981",
      "danger": "#EF4444",
      "warning": "#F59E0B",
      "bgPage": "#F6F7FB",
      "bgCard": "#FFFFFF",
      "textPrimary": "#111827",
      "textSecondary": "#6B7280",
