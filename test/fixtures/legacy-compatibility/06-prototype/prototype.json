        {
          "id": "applicant",
          "label": "申请人",
          "type": "text",
          "required": false
        },
        {
          "id": "department",
          "label": "所属部门",
          "type": "text",
          "required": false
        },
        {
          "id": "type",
          "label": "请假类型",
          "type": "select",
          "required": false
        },
        {
          "id": "startAt",
          "label": "开始时间",
          "type": "datetime",
          "required": false
        },
        {
          "id": "endAt",
          "label": "结束时间",
