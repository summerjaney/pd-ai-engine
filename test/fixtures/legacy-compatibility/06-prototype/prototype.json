  "rules": [
    {
      "id": "start-before-end",
      "description": "开始时间必须早于结束时间。",
      "appliesTo": [
        "startAt",
        "endAt"
      ]
    },
    {
      "id": "reject-comment-required",
      "description": "驳回时审批意见必填。",
      "appliesTo": [
        "reject"
      ]
    },
    {
      "id": "withdraw-pending-only",
      "description": "仅待审批申请允许撤回。",
      "appliesTo": [
        "withdraw"
      ]
    }
  ],
