{
  "schemaVersion": "0.2",
  "product": {
    "name": "员工请假管理",
    "description": "依据原始需求生成的 B 端产品原型模型。"
  },
  "tokens": {
    "color": {
      "primary": "#3B82F6",
      "success": "#10B981",
      "danger": "#EF4444",
      "warning": "#F59E0B",
      "bgPage": "#F6F7FB",
      "bgCard": "#FFFFFF",
      "textPrimary": "#111827",
      "textSecondary": "#6B7280",
      "border": "#E5E7EB"
    },
    "spacing": {
      "s8": 8,
      "s12": 12,
      "s16": 16,
      "s20": 20,
      "s24": 24,
      "s32": 32,
      "s40": 40
    },
    "radius": {
      "r8": 8,
      "r12": 12,
      "r16": 16,
      "r24": 24
    }
  },
  "screens": [
    {
      "id": "request-list",
      "name": "申请列表",
      "route": "/requests",
      "pattern": "list",
      "frame": {
        "width": 1440,
        "height": 900
      },
      "nodes": [
        {
          "id": "requestNo",
          "name": "申请编号",
          "type": "field",
          "component": "Input",
          "description": "申请编号",
          "required": false
        },
        {
          "id": "applicant",
          "name": "申请人",
          "type": "field",
          "component": "Input",
          "description": "申请人",
          "required": false
        },
        {
          "id": "department",
          "name": "所属部门",
          "type": "field",
          "component": "Input",
          "description": "所属部门",
          "required": false
        },
        {
          "id": "type",
          "name": "请假类型",
          "type": "field",
          "component": "Select",
          "description": "请假类型",
          "required": false
        },
        {
          "id": "startAt",
          "name": "开始时间",
          "type": "field",
          "component": "DateTimePicker",
          "description": "开始时间",
          "required": false
        },
        {
          "id": "endAt",
          "name": "结束时间",
          "type": "field",
          "component": "DateTimePicker",
          "description": "结束时间",
          "required": false
        },
        {
          "id": "duration",
          "name": "请假时长",
          "type": "field",
          "component": "Input",
          "description": "请假时长",
          "required": false
        },
        {
          "id": "status",
          "name": "审批状态",
          "type": "field",
          "component": "Select",
          "description": "审批状态",
          "required": false
        },
        {
          "id": "create",
          "name": "新建申请",
          "type": "action",
          "component": "Button",
          "description": "新建申请按钮"
        },
        {
          "id": "view",
          "name": "查看",
          "type": "action",
          "component": "Button",
          "description": "查看按钮"
        },
        {
          "id": "withdraw",
          "name": "撤回",
          "type": "action",
          "component": "Button",
          "description": "撤回按钮"
        }
      ],
      "interactions": [
        {
          "sourcePageId": "request-list",
          "triggerType": "action",
          "triggerId": "create",
          "triggerLabel": "新建申请",
          "targetPageId": "request-create"
