{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pae.local/schemas/v1.1/product-baseline.schema.json",
  "title": "PAE Product Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "product", "baseline", "requirements", "modules", "pages", "rules"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "project": { "$ref": "#/$defs/project" },
    "product": { "$ref": "#/$defs/product" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["requirementId", "requirementRevision", "artifact"], "properties": { "requirementId": { "type": "string", "minLength": 1 }, "requirementRevision": { "type": "integer", "minimum": 1 }, "artifact": { "type": "string", "minLength": 1 } } },
    "project": { "type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } } },
    "product": { "type": "object", "additionalProperties": false, "required": ["name", "description", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "version": { "type": "string", "minLength": 1 } } },
    "baseline": { "type": "object", "additionalProperties": false, "required": ["sequence", "status", "createdAt", "updatedAt", "hash"], "properties": { "sequence": { "type": "integer", "minimum": 1 }, "status": { "const": "accepted" }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "requirement": { "type": "object", "additionalProperties": false, "required": ["id", "name", "revision", "productVersion", "acceptedAt"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "revision": { "type": "integer", "minimum": 1 }, "productVersion": { "type": "string" }, "acceptedAt": { "type": "string", "format": "date-time" } } },
    "module": { "type": "object", "additionalProperties": false, "required": ["id", "name", "entryPageId", "roles", "source"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "entryPageId": { "type": "string" }, "roles": { "type": "array", "items": { "type": "string" } }, "source": { "$ref": "#/$defs/source" } } },
    "field": { "type": "object", "additionalProperties": false, "required": ["id", "name", "type", "required", "source"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "type": { "enum": ["text", "textarea", "select", "datetime"] }, "required": { "type": "boolean" }, "source": { "$ref": "#/$defs/source" } } },
    "action": { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "roles", "source"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "kind": { "enum": ["primary", "secondary", "danger"] }, "roles": { "type": "array", "items": { "type": "string" } }, "source": { "$ref": "#/$defs/source" } } },
    "page": { "type": "object", "additionalProperties": false, "required": ["id", "name", "route", "pattern", "roles", "fields", "actions", "source"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "route": { "type": "string" }, "pattern": { "enum": ["list", "form", "detail"] }, "roles": { "type": "array", "items": { "type": "string" } }, "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } }, "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }, "source": { "$ref": "#/$defs/source" } } },
    "rule": { "type": "object", "additionalProperties": false, "required": ["id", "description", "appliesTo", "source"], "properties": { "id": { "type": "string" }, "description": { "type": "string" }, "appliesTo": { "type": "array", "items": { "type": "string" } }, "source": { "$ref": "#/$defs/source" } } }
  }
}
