{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pae.dev/schemas/v1.0/run.schema.json",
  "title": "PAE Run State",
  "type": "object",
  "required": ["schemaVersion", "runId", "engineVersion", "status", "startedAt", "inputHash", "stages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PENDING", "RUNNING", "WAITING_CONFIRMATION", "SUCCEEDED", "FAILED", "SKIPPED", "STALE"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "currentStage": { "type": "string" },
    "inputHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resumedFromRunId": { "type": "string" },
    "stages": { "type": "array", "items": { "type": "object", "required": ["id", "status"] } }
  },
  "additionalProperties": false
}
